# 服务端口
PORT=3000

# JWT 签名密钥（生产环境务必改成 32+ 位随机字符串）
JWT_SECRET=change-this-to-a-long-random-string

# 跨域来源（H5 部署后改成自己的域名）
CORS_ORIGIN=*

# 数据库
DB_HOST=mysql
DB_PORT=3306
DB_USER=glamup
DB_PASSWORD=change_me
DB_NAME=glamup

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============ 阿里云短信 ============
# 控制台：https://dysms.console.aliyun.com/
# 1. 实名认证 → 添加签名（如「GlamUp」）→ 添加模板（如「您的验证码是 ${code}，5 分钟内有效」）
# 2. RAM 访问控制 → 创建用户 → 拿 AccessKey ID + Secret
SMS_ACCESS_KEY=
SMS_SECRET=
SMS_SIGN_NAME=GlamUp
SMS_TEMPLATE_CODE=SMS_xxxxxxxxx

# ============ 百度 AI ============
# https://console.bce.baidu.com/ai/
BAIDU_AI_API_KEY=
BAIDU_AI_SECRET_KEY=

# ============ 大模型（DeepSeek 或通义千问，可选） ============
DEEPSEEK_API_KEY=

# ============ AI 换妆图生成 ============
# 可选 provider:
#   mock     - 不调用真实 API，返回占位图（开发期默认）
#   meitu    - 美图秀秀 AI（最佳效果，需向 ai.meitu.com 申请）
#   tongyi   - 阿里云通义万相图生图（demo 用）
AI_MAKEUP_PROVIDER=mock

# 美图 API（provider=meitu 时填）
MEITU_API_KEY=
MEITU_API_SECRET=

# 阿里云通义万相 / DashScope（provider=tongyi 时填）
DASHSCOPE_API_KEY=

# ============ 阿里云 OSS（图片存储，可选） ============
OSS_ACCESS_KEY=
OSS_SECRET=
OSS_BUCKET=glamup
OSS_REGION=oss-cn-hangzhou

# ============ 微信支付 V3 ============
# 1. 微信开放平台（open.weixin.qq.com）→ 创建移动应用 → 拿 AppID
# 2. 微信支付商户平台（pay.weixin.qq.com）→ 申请商户号
# 3. 商户平台 → 账户中心 → API 安全：
#    - 下载「API 证书」，里面有 apiclient_key.pem（私钥）
#    - 抄录「证书序列号」
#    - 设置「APIv3 密钥」（32 位）
# 4. 商户平台 → 产品中心 → AppID 账户管理 → 关联 AppID
# 5. 商户平台 → 产品中心 → 开通「APP 支付」
WECHAT_APPID=
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
# 私钥两种配置方式（二选一）：
WECHAT_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem
# 或者直接放 PEM 字符串（换行用 \n 转义）
# WECHAT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
WECHAT_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.your-domain.com/api/order/callback/wechat
# 平台公钥（用于验证微信回调签名，可选；首次部署可先不配，后续从 GET /v3/certificates 拉取）
# WECHAT_PLATFORM_PUBKEY_PATH=/app/certs/wechatpay_pubkey.pem

# ============ 支付宝（可选）============
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ============ Apple In-App Purchase ============
# 用于 iOS 端订阅（必须，否则苹果审核 3.1.1 拒绝）
# 1. App Store Connect → 你的 App → App 信息 → App 专用共享密钥（Shared Secret）→ 生成
# 2. App Store Connect → 你的 App → App 内购买项目 → 创建自动续订订阅
#    产品 ID 必须与 services/apple-iap.js 的 PRODUCT_ID_MAP 一致：
#    - com.zlniao.glamup.subscription.month
#    - com.zlniao.glamup.subscription.quarter
#    - com.zlniao.glamup.subscription.year
APPLE_IAP_SHARED_SECRET=

# 日志
LOG_LEVEL=info
