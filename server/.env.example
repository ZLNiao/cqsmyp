# 服务端口
PORT=3000

# JWT 签名密钥（生产环境务必改成随机长字符串）
JWT_SECRET=change-this-to-a-long-random-string

# 跨域来源（H5 部署后改成自己的域名）
CORS_ORIGIN=*

# 数据库
DB_HOST=mysql
DB_PORT=3306
DB_USER=glamup
DB_PASSWORD=change_me
DB_NAME=glamup

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# 百度 AI（https://ai.baidu.com/）
BAIDU_AI_API_KEY=
BAIDU_AI_SECRET_KEY=

# DeepSeek 大模型（https://platform.deepseek.com/）
DEEPSEEK_API_KEY=

# 阿里云 OSS
OSS_ACCESS_KEY=
OSS_SECRET=
OSS_BUCKET=glamup
OSS_REGION=oss-cn-hangzhou

# 阿里云短信
SMS_ACCESS_KEY=
SMS_SECRET=
SMS_SIGN_NAME=GlamUp
SMS_TEMPLATE_CODE=

# 微信支付
WECHAT_APPID=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.your-domain.com/api/order/callback/wechat

# 支付宝
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 日志
LOG_LEVEL=info
